---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { subscriptions, owning, horizons, defaultHorizon } from '../data/savings';
import { site } from '../config';
---

<BaseLayout
  title="Savings — rendoire"
  description="See what your subscriptions add up to over the years, against running the same things yourself. No currency: you enter the prices."
  canonical={`${site.url}/savings/`}
>
  <Navigation />

  <main id="main" class="container section page-top">
    <div class="section-label">Savings</div>
    <h1 class="section-title">Renting vs <em>owning</em></h1>
    <p class="lead page-lead">
      What subscriptions add up to, against running the same things yourself. The prices are
      examples in no particular currency. Change them to yours.
    </p>

    <section class="sv" id="savings" aria-label="Savings calculator">
      <form id="sv-form" autocomplete="off">
        <div class="sv-top">
          <span class="sv-group" id="sv-years-label">Add it up over</span>
          <div class="sv-years" role="radiogroup" aria-labelledby="sv-years-label">
            {horizons.map((y) => (
              <label>
                <input type="radio" name="years" value={y} checked={y === defaultHorizon} data-default={y === defaultHorizon ? '' : undefined} />
                <span>{y} {y === 1 ? 'year' : 'years'}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="sv-group sv-group-row"><span>Subscriptions</span><span>per month</span></div>
        {subscriptions.map((s) => (
          <div class="sv-row" data-sub={s.id}>
            <label class="sv-check">
              <input type="checkbox" name={`on-${s.id}`} checked />
              <span>
                <span class="sv-name">{s.label}</span>
                <span class="sv-hint">{s.hint}</span>
              </span>
            </label>
            <input class="sv-num" type="number" name={`price-${s.id}`} value={s.price} min="0" step="any" inputmode="decimal" aria-label={`${s.label}, price per month`} />
            <div class="sv-track"><i class="sv-bar sv-bar-subs"></i></div>
            <output class="sv-val">0</output>
          </div>
        ))}

        <div class="sv-group sv-group-row"><span>Owning instead</span></div>
        {owning.map((c) => (
          <div class="sv-row" id={`sv-row-${c.id}`}>
            <label class="sv-check" for={`sv-${c.id}`}>
              <span>
                <span class="sv-name">{c.label}</span>
                <span class="sv-hint">{c.hint}</span>
              </span>
            </label>
            <input class="sv-num" type="number" id={`sv-${c.id}`} name={c.id} value={c.value} min="0" step="any" inputmode="decimal" />
            <div class="sv-track"><i class="sv-bar sv-bar-own"></i></div>
            <output class="sv-val">0</output>
          </div>
        ))}
      </form>

      <div class="sv-result" id="sv-result" aria-live="polite">
        <div class="sv-totals">
          <div class="sv-total" id="sv-total-subs">
            <span class="sv-total-name">Subscriptions</span>
            <div class="sv-track"><i class="sv-bar sv-bar-subs"></i></div>
            <output class="sv-val">0</output>
          </div>
          <div class="sv-total" id="sv-total-own">
            <span class="sv-total-name">Owning</span>
            <div class="sv-track"><i class="sv-bar sv-bar-own"></i></div>
            <output class="sv-val">0</output>
          </div>
        </div>
        <div class="sv-headline">
          <div>
            <div class="sv-group" id="sv-saved-label">Saved over 5 years</div>
            <div class="sv-saved" id="sv-saved">–</div>
          </div>
          <p class="sv-line" id="sv-line"></p>
        </div>
      </div>

      <button type="button" class="sv-reset" id="sv-reset">Reset to the example prices</button>
    </section>

    <div class="sv-notes">
      <h2 class="section-label">What the sums leave out</h2>
      <ul>
        <li>Your time. Setting up takes a weekend or two, and something needs attention a few times a year.</li>
        <li>Price rises. Every price here stays flat, which flatters the subscriptions.</li>
        <li>Wear. Drives last roughly five years, so over ten the hardware is bought twice.</li>
        <li>What does not carry over: family plans, day-one releases, and the largest hosted AI models. Models you run yourself are smaller and want stronger hardware.</li>
      </ul>
      <p>
        What to run in place of each one is on the <a href="/self-hosting/">self-hosting list</a>.
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../scripts/savings.ts';
</script>

<style is:global>
  .sv {
    /* Bar colours: steps of the site's lavender and green that pass the
       lightness, contrast and colour-blind separation checks on --bg. */
    --sv-subs: #9480ea;
    --sv-own: #2aa871;
    max-width: 58rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem 1.25rem;
  }
  .sv-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-bottom: 1.25rem;
  }
  .sv-group {
    font-family: var(--fm);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mid);
  }
  .sv-group-row {
    display: grid;
    grid-template-columns: minmax(0, 15rem) 5rem;
    gap: 1.25rem;
    padding: 1.1rem 0 0.35rem;
    border-top: 1px solid var(--border);
  }
  .sv-group-row span:nth-child(2) {
    text-align: right;
  }
  .sv-years {
    display: inline-flex;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    overflow: hidden;
  }
  .sv-years label {
    cursor: pointer;
  }
  .sv-years input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sv-years span {
    display: block;
    font-family: var(--fm);
    font-size: 0.76rem;
    color: var(--muted);
    padding: 0.5rem 0.9rem;
    border-left: 1px solid var(--border-strong);
    transition: background 0.15s, color 0.15s;
  }
  .sv-years label:first-child span {
    border-left: none;
  }
  .sv-years input:checked + span {
    background: var(--green);
    color: #03130c;
  }
  .sv-years input:focus-visible + span {
    outline: 2px solid var(--green);
    outline-offset: -4px;
  }

  .sv-row,
  .sv-total {
    display: grid;
    grid-template-columns: minmax(0, 15rem) 5rem minmax(0, 1fr) 4.5rem;
    gap: 1.25rem;
    align-items: center;
    padding: 0.6rem 0;
  }
  /* Totals sit on the same columns as the rows above, so the bars line up. */
  .sv-total-name {
    grid-column: 1 / 3;
  }
  .sv-check {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    cursor: pointer;
    min-width: 0;
  }
  .sv-check input {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
    accent-color: var(--green);
    flex-shrink: 0;
  }
  .sv-name {
    display: block;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .sv-hint {
    display: block;
    font-size: 0.78rem;
    color: var(--mid);
    line-height: 1.4;
    margin-top: 0.1rem;
  }
  .sv-num {
    width: 100%;
    font-family: var(--fm);
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 0.45rem 0.55rem;
  }
  .sv-num:disabled {
    opacity: 0.35;
  }
  .sv-row.is-off .sv-name,
  .sv-row.is-off .sv-hint,
  .sv-row.is-off .sv-val {
    opacity: 0.45;
  }
  .sv-track {
    height: 14px;
    min-width: 0;
  }
  .sv-bar {
    display: block;
    height: 100%;
    width: 0;
    min-width: 2px;
    border-radius: 0 4px 4px 0;
  }
  .sv-bar[style*='width: 0%'] {
    min-width: 0;
  }
  .sv-bar-subs {
    background: var(--sv-subs);
  }
  .sv-bar-own {
    background: var(--sv-own);
  }
  .sv-row:hover .sv-bar,
  .sv-total:hover .sv-bar {
    filter: brightness(1.18);
  }
  .sv-val {
    font-family: var(--fm);
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--text);
  }

  .sv-result {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .sv-total .sv-track {
    height: 22px;
  }
  .sv-total-name {
    font-size: 0.95rem;
  }
  .sv-total .sv-val {
    font-size: 1rem;
    font-weight: 500;
  }
  .sv-headline {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem 2.5rem;
    margin-top: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .sv-saved {
    font-family: var(--fd);
    font-size: clamp(2.6rem, 7vw, 3.8rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--green);
    margin-top: 0.4rem;
  }
  /* Green means money saved; an extra cost is not dressed up as one. */
  .sv-result.is-loss .sv-saved {
    color: var(--text);
  }
  .sv-line {
    flex: 1 1 16rem;
    max-width: 26rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    padding-bottom: 0.35rem;
  }
  .sv-reset {
    font-family: var(--fm);
    font-size: 0.74rem;
    color: var(--muted);
    background: none;
    border: none;
    padding: 0.4rem 0;
    margin-top: 0.9rem;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .sv-reset:hover {
    color: var(--green);
  }

  .sv-notes {
    margin-top: 3rem;
    max-width: 40rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .sv-notes ul {
    list-style: disc;
    padding-left: 1.1rem;
    margin-bottom: 1rem;
  }
  .sv-notes li {
    margin-top: 0.5rem;
  }
  .sv-notes a {
    color: var(--green);
    text-decoration: underline;
    text-decoration-color: rgba(62, 207, 142, 0.35);
    text-underline-offset: 4px;
  }

  @media (max-width: 720px) {
    .sv {
      padding: 1.1rem 1rem 0.9rem;
    }
    .sv-row {
      grid-template-columns: minmax(0, 1fr) 4.75rem;
      gap: 0.5rem 0.9rem;
      padding: 0.75rem 0;
    }
    .sv-row .sv-track {
      grid-column: 1;
    }
    .sv-group-row {
      grid-template-columns: minmax(0, 1fr) 4.75rem;
      gap: 0.9rem;
    }
    .sv-total {
      grid-template-columns: minmax(0, 1fr) 4.75rem;
      gap: 0.35rem 0.9rem;
    }
    .sv-total-name {
      grid-column: 1 / -1;
    }
  }
</style>
