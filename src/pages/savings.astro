---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { subscriptions, costs } from '../data/savings';
import { site } from '../config';
---

<BaseLayout
  title="Savings — rendoire"
  description="Work out what your subscriptions cost over five years against running the same services yourself. Any currency: you enter the prices."
  canonical={`${site.url}/savings/`}
>
  <Navigation />

  <main id="main" class="container section page-top">
    <div class="section-label">Calculator</div>
    <h1 class="section-title">Renting vs <em>owning</em></h1>
    <p class="lead page-lead">
      What your subscriptions add up to over five years, against the cost of running the same
      things on your own hardware. The figures are examples with no currency attached. Replace
      them with what you pay.
    </p>

    <div class="sv" id="savings">
      <form class="sv-form" id="sv-form" autocomplete="off">
        <fieldset>
          <legend>What you pay per month</legend>
          {subscriptions.map((s) => (
            <div class="sv-row" data-sub={s.id}>
              <label class="sv-check">
                <input type="checkbox" name={`on-${s.id}`} checked />
                <span>
                  <span class="sv-name">{s.label}</span>
                  <span class="sv-hint">{s.examples} → {s.replacement}</span>
                </span>
              </label>
              <input
                class="sv-num"
                type="number"
                name={`price-${s.id}`}
                value={s.price}
                min="0"
                step="any"
                inputmode="decimal"
                aria-label={`${s.label}, price per month`}
              />
              <p class="sv-caveat">{s.caveat}</p>
            </div>
          ))}
        </fieldset>

        <fieldset>
          <legend>What owning costs</legend>
          {costs.map((c) => (
            <div class="sv-row sv-row-cost">
              <label class="sv-check" for={`sv-${c.id}`}>
                <span>
                  <span class="sv-name">{c.label}</span>
                  <span class="sv-hint">{c.hint}</span>
                </span>
              </label>
              <input class="sv-num" type="number" id={`sv-${c.id}`} name={c.id} value={c.value} min="0" step="any" inputmode="decimal" />
            </div>
          ))}
        </fieldset>

        <button type="button" class="sv-reset" id="sv-reset">Reset to the example figures</button>
      </form>

      <div class="sv-results">
        <dl class="sv-stats">
          <div>
            <dt>Subscriptions now</dt>
            <dd><span id="sv-now">–</span><small>per month</small></dd>
          </div>
          <div>
            <dt>After switching</dt>
            <dd><span id="sv-after">–</span><small>per month</small></dd>
          </div>
          <div>
            <dt>Break-even</dt>
            <dd><span id="sv-be">–</span><small id="sv-be-note"></small></dd>
          </div>
          <div class="sv-stat-main">
            <dt id="sv-total-label">Saved over 5 years</dt>
            <dd><span id="sv-total">–</span><small id="sv-total-note"></small></dd>
          </div>
        </dl>

        <figure class="sv-figure">
          <figcaption>
            <span id="sv-chart-title">Total spent over five years</span>
            <ul class="sv-legend">
              <li><i class="sv-key sv-key-subs"></i>Subscriptions</li>
              <li><i class="sv-key sv-key-own"></i>Your own hardware</li>
            </ul>
          </figcaption>
          <div class="sv-plot">
            <div
              class="sv-chart"
              id="sv-chart"
              tabindex="0"
              aria-label="Chart of total spent over five years. Use the left and right arrow keys to read each month."
            >
            </div>
            <div class="sv-tip" id="sv-tip" hidden>
              <div class="sv-tip-when" id="sv-tip-when"></div>
              <div class="sv-tip-row"><i class="sv-key sv-key-subs"></i><b id="sv-tip-subs"></b><span>Subscriptions</span></div>
              <div class="sv-tip-row"><i class="sv-key sv-key-own"></i><b id="sv-tip-own"></b><span>Your own hardware</span></div>
              <div class="sv-tip-diff" id="sv-tip-diff"></div>
            </div>
          </div>
          <details class="sv-table">
            <summary>Show the numbers as a table</summary>
            <table>
              <thead>
                <tr><th scope="col">When</th><th scope="col">Subscriptions</th><th scope="col">Your own hardware</th><th scope="col">Difference</th></tr>
              </thead>
              <tbody id="sv-table-body"></tbody>
            </table>
          </details>
        </figure>

        <div class="sv-notes">
          <h2 class="section-label">What this leaves out</h2>
          <ul>
            <li>Your time. Setting this up takes a weekend or two, and something will need attention a few times a year.</li>
            <li>Price rises. Subscriptions tend to go up; the chart holds every price flat, which flatters them.</li>
            <li>Hardware wears out. Drives last roughly five years, so treat the hardware figure as recurring on that scale.</li>
            <li>What does not transfer: shared family plans, new releases on day one, and the largest hosted AI models.</li>
          </ul>
          <p>
            The replacements named here are on the <a href="/self-hosting/">self-hosting list</a>{' '}and{' '}<a href="/tools/">tools</a> pages.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../scripts/savings.ts';
</script>

<style is:global>
  .sv {
    /* Chart series: steps of the site's lavender and green that pass the
       lightness, contrast and colour-blind separation checks on --bg. */
    --sv-subs: #9480ea;
    --sv-own: #2aa871;
    display: grid;
    grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .sv-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .sv-form fieldset {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.4rem 1.25rem 0.6rem;
    min-width: 0;
  }
  .sv-form legend {
    font-family: var(--fm);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 0.5rem;
    margin-left: -0.5rem;
  }
  .sv-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
  }
  .sv-row:first-of-type {
    border-top: none;
  }
  .sv-check {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    cursor: pointer;
  }
  .sv-check input {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
    accent-color: var(--green);
    flex-shrink: 0;
  }
  .sv-name {
    display: block;
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .sv-hint {
    display: block;
    font-family: var(--fm);
    font-size: 0.72rem;
    color: var(--mid);
    line-height: 1.5;
    margin-top: 0.15rem;
  }
  .sv-num {
    width: 100%;
    font-family: var(--fm);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 0.5rem 0.6rem;
  }
  .sv-num:disabled {
    opacity: 0.4;
  }
  .sv-caveat {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: var(--mid);
    line-height: 1.5;
    padding-left: 1.8rem;
  }
  .sv-row.is-off .sv-name,
  .sv-row.is-off .sv-hint,
  .sv-row.is-off .sv-caveat {
    opacity: 0.5;
  }
  .sv-reset {
    align-self: flex-start;
    font-family: var(--fm);
    font-size: 0.74rem;
    color: var(--muted);
    background: none;
    border: none;
    padding: 0.4rem 0;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .sv-reset:hover {
    color: var(--green);
  }

  .sv-results {
    min-width: 0;
    position: sticky;
    top: 84px;
  }
  .sv-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .sv-stats > div {
    background: var(--bg);
    padding: 1.1rem 1.1rem 1.2rem;
    min-width: 0;
  }
  .sv-stats dt {
    font-family: var(--fm);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mid);
    margin-bottom: 0.5rem;
  }
  .sv-stats dd span {
    display: block;
    font-family: var(--fd);
    font-size: 1.9rem;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sv-stats small {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
    margin-top: 0.35rem;
  }
  .sv-stat-main {
    background: var(--surface) !important;
  }
  .sv-stat-main dd span {
    color: var(--green);
  }
  /* Green means money saved; an extra cost is not dressed up as one. */
  .sv-stat-main.is-loss dd span {
    color: var(--text);
  }

  .sv-figure {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.25rem 0.75rem;
  }
  .sv-figure figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-family: var(--fm);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .sv-legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .sv-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sv-key {
    display: inline-block;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    flex-shrink: 0;
  }
  .sv-key-subs {
    background: var(--sv-subs);
  }
  .sv-key-own {
    background: var(--sv-own);
  }
  .sv-plot {
    position: relative;
  }
  .sv-chart {
    min-height: 260px;
    cursor: crosshair;
    border-radius: 4px;
    touch-action: pan-y;
  }
  .sv-chart svg {
    display: block;
    overflow: visible;
  }
  .sv-grid {
    stroke: rgba(255, 255, 255, 0.06);
  }
  .sv-axis {
    stroke: var(--border-strong);
  }
  .sv-tick {
    font-family: var(--fm);
    font-size: 11px;
    fill: var(--mid);
    font-variant-numeric: tabular-nums;
  }
  .sv-line {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .sv-subs {
    stroke: var(--sv-subs);
  }
  .sv-own {
    stroke: var(--sv-own);
  }
  .sv-wedge {
    fill: var(--sv-own);
    opacity: 0.12;
  }
  .sv-end-value {
    font-family: var(--fm);
    font-size: 13px;
    font-weight: 500;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .sv-end-name {
    font-family: var(--fm);
    font-size: 10.5px;
    fill: var(--muted);
  }
  .sv-be-drop {
    stroke: var(--border-strong);
    stroke-dasharray: 2 4;
  }
  .sv-be-dot {
    fill: var(--text);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .sv-be-label {
    font-family: var(--fm);
    font-size: 11.5px;
    fill: var(--text);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
  }
  .sv-cross {
    stroke: var(--border-strong);
  }
  .sv-pt {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .sv-subs-pt {
    fill: var(--sv-subs);
  }
  .sv-own-pt {
    fill: var(--sv-own);
  }
  .sv-tip {
    position: absolute;
    top: 8px;
    pointer-events: none;
    background: var(--surface2);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 0.6rem 0.75rem;
    font-size: 0.8rem;
    white-space: nowrap;
    z-index: 2;
  }
  .sv-tip-when,
  .sv-tip-diff {
    font-family: var(--fm);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .sv-tip-when {
    margin-bottom: 0.35rem;
  }
  .sv-tip-diff {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--border);
  }
  .sv-tip-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1.6;
  }
  .sv-tip-row b {
    font-family: var(--fm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    min-width: 3.2rem;
  }
  .sv-tip-row span {
    color: var(--muted);
  }
  .sv-table {
    margin-top: 0.5rem;
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
  }
  .sv-table summary {
    font-family: var(--fm);
    font-size: 0.74rem;
    color: var(--muted);
    cursor: pointer;
    padding: 0.3rem 0;
  }
  .sv-table table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .sv-table th,
  .sv-table td {
    text-align: right;
    padding: 0.45rem 0.5rem;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }
  .sv-table th:first-child {
    text-align: left;
  }
  .sv-table thead th {
    font-family: var(--fm);
    font-size: 0.7rem;
    color: var(--mid);
  }

  .sv-notes {
    margin-top: 2.5rem;
    max-width: 40rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .sv-notes ul {
    list-style: disc;
    padding-left: 1.1rem;
    margin-bottom: 1rem;
  }
  .sv-notes li {
    margin-top: 0.5rem;
  }
  .sv-notes a {
    color: var(--green);
    text-decoration: underline;
    text-decoration-color: rgba(62, 207, 142, 0.35);
    text-underline-offset: 4px;
  }

  @media (max-width: 1040px) {
    .sv {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sv-results {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .sv-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sv-stats dd span {
      font-size: 1.6rem;
    }
    .sv-figure {
      padding: 1rem 0.75rem 0.5rem;
    }
  }
</style>
