---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HomelabMonitor from '../components/react/HomelabMonitor.tsx';

const books = [
  { author: 'Steven Pressfield', title: 'The War of Art', status: 'finished', color: 'var(--green)' },
  { author: 'Walter Isaacson', title: 'Steve Jobs', status: 'finished', color: 'var(--blue)' },
  { author: 'John Markoff', title: 'What the Dormouse Said', status: 'reading', color: 'var(--purple)' },
  { author: 'Cal Newport', title: 'Deep Work', status: 'finished', color: 'var(--amber)' },
  { author: 'Nassim Taleb', title: 'Antifragile', status: 'finished', color: 'var(--green)' },
  { author: "O'Reilly Media", title: 'AI Engineering', status: 'want to read', color: 'var(--blue)' },
  { author: 'Martin Kleppmann', title: 'Designing Data-Intensive Applications', status: 'reading', color: 'var(--purple)' },
  { author: 'Marcus Aurelius', title: 'Meditations', status: 'finished', color: 'var(--amber)' },
  { author: 'Paul Graham', title: 'Hackers & Painters', status: 'finished', color: 'var(--green)' },
];
---

<BaseLayout
  title="Lab — rendoire"
  description="My self-hosted homelab and the books I'm reading."
  canonical="https://rendoire.com/lab/"
>
  <Navigation />

  <main id="main" class="container section" style="padding-top: 4rem;">
    <div class="section-label">Lab</div>
    <h1 class="section-title">The <em>lab</em></h1>
    <p style="color: var(--muted); max-width: 44rem; margin-top: -1.5rem; margin-bottom: 3rem;">
      I run my own AI stack at home. Here's a live view of the machines — and the books feeding the work.
    </p>
    <HomelabMonitor client:visible />
  </main>

  <section class="container" style="padding: 4rem 0 5rem;">
    <div class="section-label">Reading list</div>
    <h2 class="section-title">Books I <em>enjoy</em></h2>
    <div class="post-grid">
      {books.map((b) => (
        <div class="post-card card-polished" style="padding:1.6rem; min-height:150px;">
          <div class="post-meta">
            <span style={`color:${b.color};`}>{b.author}</span>
            <span style="border:1px solid var(--border); padding:0.1rem 0.5rem; border-radius:999px;">{b.status}</span>
          </div>
          <h3 class="post-title" style="font-size:1.3rem;">{b.title}</h3>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>
