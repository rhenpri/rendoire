---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    name: 'cade.golf',
    desc: 'A social golf app for Irish golfers. Log rounds, track your mates, discover courses, and settle arguments mid-round.',
    link: 'https://cade.golf',
    linkText: 'Visit cade.golf ↗',
    accent: 'var(--green)',
    stack: ['Astro', 'TypeScript', 'Node.js', 'PostgreSQL'],
  },
  {
    name: 'Self-Hosted AI',
    desc: 'Complete AI systems on hardware I own and manage — language models, agent frameworks, reasoning pipelines, and automation networks, all running privately.',
    accent: 'var(--blue)',
    stack: ['Proxmox', 'Ollama', 'n8n', 'Tailscale'],
  },
  {
    name: 'Live Service Engineering',
    desc: 'High-stakes incident response, observability, and production tooling. Keeping complex, distributed systems alive in production.',
    accent: 'var(--purple)',
    stack: ['Go', 'Kubernetes', 'Datadog', 'Terraform'],
  },
  {
    name: 'AI Education',
    desc: 'Workshops, written content, and digital learning materials that teach AI and agents to practitioners. Co-founded a programme that ran cohort training.',
    accent: 'var(--amber)',
    stack: ['Python', 'LangChain', 'Jupyter', 'Vercel'],
  },
];
---

<BaseLayout
  title="Projects — rendoire"
  description="Recent work in AI systems, live service engineering, and self-hosting."
  canonical="https://rendoire.com/projects/"
>
  <Navigation />

  <main id="main" class="container section" style="padding-top: 4rem;">
    <div class="section-label">Projects</div>
    <h1 class="section-title">Recent <em>work</em></h1>

    <div class="post-grid" style="grid-template-columns: repeat(2, 1fr);">
      {projects.map((p, i) => (
        <a href={p.link ?? undefined} target={p.link ? '_blank' : undefined} rel={p.link ? 'noopener' : undefined} class="post-card card-polished" style="padding:2.25rem; text-decoration:none; cursor:{p.link ? 'pointer' : 'default'};">
          <span class="post-meta" style={`color:${p.accent};`}>{String(i + 1).padStart(2, '0')}</span>
          <h3 class="post-title" style="font-size:1.9rem; margin-bottom:0.9rem;">{p.name}</h3>
          <p class="post-desc" style="-webkit-line-clamp: unset;">{p.desc}</p>
          <div class="post-tags">
            {p.stack.map((s) => <span class="tag" style="border-color: var(--border-strong); color: var(--mid);">{s}</span>)}
          </div>
          {p.link && <span class="post-arrow">{p.linkText}</span>}
        </a>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
