---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="404 — rendoire"
  description="Page not found."
  canonical="https://rendoire.com/404"
>
  <Navigation />

  <main id="main" class="container" style="min-height: 72vh; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding: 6rem 2rem;">
    <p class="section-label" style="justify-content:center;">Error 404</p>
    <h1 class="hero-wordmark" style="font-size: clamp(3rem, 10vw, 7rem);">Off<em class="accent">_</em>Grid</h1>
    <p style="color: var(--muted); max-width: 30rem; line-height: 1.7; margin-bottom: 2.5rem;">
      The route you requested can't be resolved. The page never existed — or the edge node dropped it.
    </p>
    <a href="/" class="newsletter-cta" style="font-size:0.75rem;">Return home ↗</a>
  </main>

  <Footer />
</BaseLayout>
