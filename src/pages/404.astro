---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getPosts } from '../lib/blog';

const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout title="Page not found — rendoire" description="Page not found." noindex>
  <Navigation />

  <main id="main" class="container not-found">
    <p class="section-label">Error 404</p>
    <h1 class="hero-title">Off<em>_</em>grid</h1>
    <p class="lead">
      There's nothing at this address. The page may have moved, or the link that brought you here
      was mistyped.
    </p>
    <div class="not-found-links">
      <a href="/" class="newsletter-cta">Go to the homepage</a>
      <a href="/blog/" class="newsletter-alt">or browse all essays</a>
    </div>

    <div class="not-found-latest">
      <h2 class="section-label">Latest essays</h2>
      <ul>
        {latest.map((p) => (
          <li><a href={`/blog/${p.slug}/`}>{p.title}</a> <span>{p.dateLabel}</span></li>
        ))}
      </ul>
    </div>
  </main>

  <Footer />
</BaseLayout>
