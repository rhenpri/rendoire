---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import PintButton from '../../components/PintButton.astro';
import { formatDate, getEntries, relatedPosts, summarize, topicLabel } from '../../lib/blog';
import { person, site } from '../../config';

export async function getStaticPaths() {
  const entries = await getEntries();
  const all = entries.map(summarize);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, post: all[i], related: relatedPosts(all[i], all) },
  }));
}

const { entry, post, related } = Astro.props;
const { Content } = await render(entry);

const url = `${site.url}/blog/${post.slug}/`;

// Social cards want a fixed-size JPEG, not the responsive WebP the page uses.
const ogImage = post.cover
  ? (await getImage({ src: post.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : '/og-image.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.pubDate.toISOString(),
  dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
  url,
  image: new URL(ogImage, site.url).href,
  author: person,
  publisher: person,
  keywords: post.tags.map(topicLabel).join(', '),
  mainEntityOfPage: url,
};
---

<BaseLayout
  title={`${post.title} — rendoire`}
  description={post.description ?? post.title}
  canonical={url}
  image={ogImage}
  type="article"
  jsonLd={jsonLd}
>
  <Navigation />
  <div class="reading-progress" aria-hidden="true"></div>

  <main id="main" class="container page-top">
    <article class="article-wrap">
      <a href="/blog/" class="article-back">← All essays</a>

      <header class="article-header">
        <div class="article-meta">
          <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate, 'long')}</time>
          <span aria-hidden="true">·</span>
          <span>{post.readingTime}</span>
          {post.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={post.updatedDate.toISOString()}>{formatDate(post.updatedDate, 'long')}</time></span>
            </>
          )}
        </div>
        <h1 class="article-title">{post.title}</h1>
        {post.tags.length > 0 && (
          <ul class="post-tags" aria-label="Topics">
            {post.tags.map((tag) => (
              <li><a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag">{topicLabel(tag)}</a></li>
            ))}
          </ul>
        )}
      </header>

      {post.cover && (
        <div class="article-cover">
          <Image
            src={post.cover}
            alt={post.coverAlt}
            widths={[640, 960, 1408]}
            sizes="(max-width: 760px) 100vw, 704px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="article-body">
        <Content />
      </div>

      <footer class="article-foot">
        <p>
          Thanks for reading. New essays arrive by <a href="/feed.xml">RSS</a>{post.medium && (
            <>, and this one is <a href={post.medium} target="_blank" rel="noopener">also on Medium ↗</a></>
          )}.
        </p>
        <div class="article-support">
          <p>If this saved you some time or gave you something to think about, you can buy me a pint.</p>
          <PintButton />
        </div>
      </footer>
    </article>

    {related.length > 0 && (
      <aside class="article-wrap keep-reading" aria-labelledby="keep-reading">
        <h2 class="section-label" id="keep-reading">Keep reading</h2>
        <div class="keep-reading-grid">
          {related.map((p) => (
            <a href={`/blog/${p.slug}/`} class="card keep-reading-card">
              <span class="post-meta">
                <span>{p.tags.slice(0, 1).map(topicLabel)}</span>
                <span>{p.readingTime}</span>
              </span>
              <h3 class="post-title">{p.title}</h3>
              {p.description && <p class="post-desc">{p.description}</p>}
            </a>
          ))}
        </div>
      </aside>
    )}
  </main>

  <Footer />
</BaseLayout>
