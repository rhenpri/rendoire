---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { categories, statusLabel } from '../data/self-hosting';
import MiniViz from '../components/MiniViz.astro';

import { execSync } from 'node:child_process';

const domain = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const total = categories.reduce((n, c) => n + c.items.length, 0);

// A list of recommendations is only as good as it is current, so say when the
// data last changed. Falls back to nothing outside a git checkout.
let updated: Date | null = null;
try {
  const iso = execSync('git log -1 --format=%cI -- src/data/self-hosting.ts').toString().trim();
  if (iso) updated = new Date(iso);
} catch {}
const updatedLabel = updated?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Self-hosting — rendoire"
  description="A curated, opinionated list of tools for owning your data — Linux, private cloud, security, and local AI."
  canonical="https://rendoire.com/self-hosting/"
>
  <Navigation />

  <main id="main" class="container section" style="padding-top: 4rem;">
    <div class="section-label">Recommendations</div>
    <h1 class="section-title">Self-<em>hosting</em></h1>
    <p class="lead" style="margin-top:-1.25rem; margin-bottom:1.5rem;">
      A short, opinionated list: things I've used, plus a few I'm keeping an eye on. Every link
      goes straight to the project.
    </p>
    <p class="fine-print">
      {total} tools in {categories.length} categories{updated && (
        <> · last updated <time datetime={updated.toISOString()}>{updatedLabel}</time></>
      )}
    </p>

    <div class="dir-layout" style="margin-top: 1rem;">
      <aside class="dir-sidebar" aria-label="Categories">
        <input
          type="search"
          id="dir-search"
          class="dir-search"
          placeholder="Search tools…"
          aria-label="Search tools"
          autocomplete="off"
        />
        {categories.map((cat, i) => (
          <button class="dir-nav-btn" data-target={cat.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {String(i + 1).padStart(2, '0')} · {cat.label}
          </button>
        ))}
      </aside>

      <div class="dir-content" id="dir-content">
        {categories.map((cat, i) => (
          <section id={cat.id} class="dir-section" data-section={cat.id}>
            <h2 class="dir-section-title">
              <MiniViz variant={cat.viz} class="cat-viz" />
              <span class="idx">{String(i + 1).padStart(2, '0')}</span> {cat.label}
            </h2>
            <p class="dir-section-blurb">{cat.blurb}</p>
            <div class="dir-grid">
              {cat.items.map((item) => (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener"
                  class="card dir-card"
                  data-search={`${item.name} ${item.tagline} ${item.why} ${cat.label}`.toLowerCase()}
                >
                  <div class="dir-card-top">
                    <span class="dir-tagline">{item.tagline}</span>
                    <span style="display:flex; gap:0.4rem; align-items:flex-start;">
                      {item.eu && <span class="eu-badge" title="European project">EU</span>}
                      <span class={`status-badge status-${item.status}`}>{statusLabel[item.status]}</span>
                    </span>
                  </div>
                  <h3 class="dir-name">{item.name}</h3>
                  <p class="dir-why">{item.why}</p>
                  <span class="dir-link">{domain(item.link)} ↗</span>
                </a>
              ))}
            </div>
          </section>
        ))}
        <p id="dir-empty" class="dir-empty" hidden>
          Nothing matches “<span id="dir-empty-term"></span>”.
          <button type="button" id="dir-clear">Clear search</button>
        </p>
        <p id="dir-status" class="visually-hidden" role="status"></p>
      </div>
    </div>

    <p style="font-family:var(--fm); font-size:0.66rem; color:var(--mid); margin-top:3rem; line-height:1.7;">
      No affiliate links and no sponsors — just the tools I reach for. Your data, your rules.
    </p>
  </main>

  <Footer />
</BaseLayout>

<script>
  (function () {
    const buttons = document.querySelectorAll('.dir-nav-btn');
    const sections = document.querySelectorAll('[data-section]');

    const setActive = (id) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.target === id)));
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = document.getElementById(btn.dataset.target);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
      { rootMargin: '-20% 0px -70% 0px' },
    );
    sections.forEach((s) => io.observe(s));

    const search = document.getElementById('dir-search');
    const empty = document.getElementById('dir-empty');
    const emptyTerm = document.getElementById('dir-empty-term');
    const status = document.getElementById('dir-status');
    const cards = [...document.querySelectorAll('[data-search]')];
    if (!search) return;

    const filter = () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const show = !q || card.dataset.search.includes(q);
        card.hidden = !show;
        if (show) visible++;
      });
      sections.forEach((section) => {
        section.hidden = !section.querySelector('[data-search]:not([hidden])');
      });
      empty.hidden = visible > 0;
      emptyTerm.textContent = search.value.trim();
      status.textContent = q ? `${visible} of ${cards.length} tools match.` : '';
    };

    search.addEventListener('input', filter);
    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && search.value) {
        search.value = '';
        filter();
      }
    });
    document.getElementById('dir-clear').addEventListener('click', () => {
      search.value = '';
      filter();
      search.focus();
    });
  })();
</script>
