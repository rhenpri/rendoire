---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/blog/PostCard.astro';
import Subscribe from '../components/Subscribe.astro';
import MiniViz from '../components/MiniViz.astro';
import { getPosts } from '../lib/blog';
import { site, person, author } from '../config';

const posts = await getPosts();
const featured = posts.find((p) => p.featured) ?? posts[0];
const recent = posts.filter((p) => p.slug !== featured?.slug).slice(0, 6);

const pillars = [
  {
    index: '01',
    title: 'Writing',
    desc: 'Essays on AI, software, and the layer between the model and the real world.',
    href: '/blog/',
    viz: 'token',
    cta: 'Read the journal',
  },
  {
    index: '02',
    title: 'Self-hosting',
    desc: 'Tools for owning your data: Linux, private cloud, privacy apps, and the boxes to run them.',
    href: '/self-hosting/',
    viz: 'infra',
    cta: 'Browse the list',
  },
  {
    index: '03',
    title: 'AI knowledge',
    desc: 'A practical learning path and the O’Reilly books that earn their shelf space.',
    href: '/ai/',
    viz: 'nn',
    cta: 'Start learning',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  author: person,
};
---

<BaseLayout jsonLd={jsonLd}>
  <Navigation />

  <main id="main">
    <header class="hero container">
      <div class="hero-text">
        <h1 class="hero-title">ren<em>doire</em></h1>
        <p class="hero-tagline">
          Essays on putting AI to work in the real world, and a guide to self-hosting.
        </p>
        <p class="hero-byline">
          By <a href="/about/">{author.name}</a>, {author.role.toLowerCase()} in {author.location}.
        </p>
      </div>
      <canvas class="hero-field" id="hero-field" aria-hidden="true"></canvas>
    </header>

    {featured && (
      <section class="container home-featured" aria-label="Latest essay">
        <a href={`/blog/${featured.slug}/`} class="featured-card">
          <div class="featured-body">
            <span class="featured-kicker">Latest essay</span>
            <h2 class="featured-title">{featured.title}</h2>
            {featured.description && <p class="featured-desc">{featured.description}</p>}
            <div class="post-meta" style="margin-bottom:0;">
              <time datetime={featured.pubDate.toISOString()}>{featured.dateLabel}</time>
              <span>{featured.readingTime}</span>
            </div>
          </div>
          {featured.cover && (
            <div class="featured-media">
              <Image
                src={featured.cover}
                alt={featured.coverAlt}
                widths={[480, 800, 1200]}
                sizes="(max-width: 960px) 100vw, 520px"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}
        </a>
      </section>
    )}

    <nav class="container" aria-label="Sections">
      <div class="pillar-grid">
        {pillars.map((p) => (
          <a href={p.href} class="pillar-card">
            <span class="pillar-top" aria-hidden="true">
              <span class="pillar-index">{p.index}</span>
              <MiniViz variant={p.viz} class="pillar-viz" />
            </span>
            <h2 class="pillar-title">{p.title}</h2>
            <p class="pillar-desc">{p.desc}</p>
            <span class="pillar-link" aria-hidden="true">{p.cta} →</span>
          </a>
        ))}
      </div>
    </nav>

    <section class="container home-savings">
      <a href="/savings/" class="savings-teaser">
        <span class="savings-spark" aria-hidden="true">
          <i class="spark-bar spark-subs"></i>
          <i class="spark-bar spark-own"></i>
        </span>
        <span class="savings-teaser-text">
          <strong>Renting vs owning</strong>
          <span>What subscriptions add up to over the years, against running the same things yourself.</span>
        </span>
        <span class="pillar-link" aria-hidden="true">Work it out →</span>
      </a>
    </section>

    <section class="section container">
      <div class="section-head">
        <div>
          <div class="section-label">Journal</div>
          <h2 class="section-title">Recent <em>writing</em></h2>
        </div>
        <a href="/blog/" class="section-more">All {posts.length} essays →</a>
      </div>
      <div class="post-grid">
        {recent.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <section class="container">
      <Subscribe />
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import '../scripts/hero-field.ts';
</script>
