---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PintButton from '../components/PintButton.astro';
import { author, person, site } from '../config';
import { series } from '../data/series';

const route = [
  {
    when: '2016',
    title: 'Left school at 16',
    desc: 'Took a BTEC in IT at North West Regional College instead of A-levels, and finished with a triple Distinction*. College was where it clicked.',
  },
  {
    when: '2019',
    title: 'Degree apprentice',
    desc: 'Started a degree apprenticeship: four days a week at work, one at university, fully funded and no student debt.',
  },
  {
    when: '2022',
    title: 'Live services',
    desc: 'Started running and improving live services, which is still my day job.',
  },
  {
    when: '2023',
    title: 'BSc (Hons) Business Technology, Ulster University',
    desc: 'Graduated with a 2:1. My dissertation asked how AI would change consulting, ten months after ChatGPT launched.',
  },
  {
    when: '2024',
    title: 'AI engineering',
    desc: 'Started building with AI in live services.',
  },
  {
    when: '2025',
    title: 'Technology manager',
    desc: 'Leading engineering on live services, and putting AI to work in them.',
  },
];

const projects = [
  {
    name: 'cadé.golf',
    desc: 'A social golf app for you and your mates: track rounds, share moments, and improve your game.',
    href: 'https://cade.golf',
  },
  {
    name: 'A Kindle that answers to me',
    desc: 'A 2013 Paperwhite with no Amazon account, a library I own and a morning edition every day.',
    href: '/blog/i-just-broke-my-kindle-and-it-got-way-better/',
  },
  {
    name: 'This site',
    desc: 'Static, no cookies or ad trackers, cookieless page counts only, and a strict content security policy. The source is public.',
    href: 'https://github.com/rhenpri/rendoire',
  },
];

const social = [
  { label: 'Medium', handle: '@rendoire', href: 'https://rendoire.medium.com' },
  { label: 'GitHub', handle: 'rhenpri', href: 'https://github.com/rhenpri' },
  { label: 'LinkedIn', handle: 'rhenderson832', href: 'https://www.linkedin.com/in/rhenderson832/' },
  { label: 'YouTube', handle: '@rendoire', href: 'https://www.youtube.com/@rendoire' },
  { label: 'RSS', handle: 'feed.xml', href: '/feed.xml' },
];


---

<BaseLayout
  image="/og/about.png"
  title={`About ${author.name} — rendoire`}
  description={`${author.name}: ${author.short} What I write about, what I have built, and where to find me.`}
  canonical="https://rendoire.com/about/"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person }}
>
  <Navigation />

  <main id="main" class="container section" style="padding-top: 4rem;">
    <div class="section-label">About</div>
    <h1 class="section-title">Nice to <em>meet you</em></h1>
    <p class="lead">
      I'm {author.name}, a technology manager in {author.location}. I run live services for the
      build with AI. Here I write about what happens when AI
      meets a real organisation, and about running more of my own technology.
    </p>
    <p class="lead" style="margin-top:1rem;">
      I didn't take the usual route in. I left school at 16, did my degree while working full
      time, and I'm dyslexic, which shapes how I think more than it limits it.
      I've <a href="/blog/think-different-the-dyslexic-advantage-in-systems-thinking/">written about that</a>.
      The essays are my own views, not my employer's.
    </p>

    <section style="margin-top: 4rem;" aria-labelledby="route">
      <div class="section-label" id="route">How I got here</div>
      <ol class="route">
        {route.map((r) => (
          <li>
            <span class="route-when">{r.when}</span>
            <div>
              <h2 class="route-title">{r.title}</h2>
              <p class="route-desc">{r.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">What I write about</div>
      <div class="post-grid">
        {Object.values(series).map((s) => (
          <a href="/blog/" class="card" style="min-height: 150px;">
            <h2 class="post-title" style="font-size:1.3rem;">{s.title}</h2>
            <p class="post-desc" style="-webkit-line-clamp: unset;">{s.blurb}</p>
          </a>
        ))}
        <a href="/ai/" class="card" style="min-height: 150px;">
          <h2 class="post-title" style="font-size:1.3rem;">Learning AI properly</h2>
          <p class="post-desc" style="-webkit-line-clamp: unset;">A learning path from the maths up to agents, with the books worth the time.</p>
        </a>
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">Things I've built</div>
      <div class="post-grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
        {projects.map((p) => {
          const external = p.href?.startsWith('http');
          const Tag = p.href ? 'a' : 'div';
          return (
            <Tag
              href={p.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              class="card"
              style="min-height: 150px;"
            >
              <h3 class="post-title" style="font-size:1.2rem;">{p.name}{external && ' ↗'}</h3>
              <p class="post-desc" style="-webkit-line-clamp: unset;">{p.desc}</p>
            </Tag>
          );
        })}
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">Talks</div>
      <p class="lead" style="max-width:44rem;">
        I give STEM workshops and careers talks in local schools and colleges, about technology
        and about getting into it without A-levels. If you run a school, college or community
        group and want a talk, <a href={site.linkedin} target="_blank" rel="noopener">message me on LinkedIn</a>.
      </p>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">Find me</div>
      <div class="post-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
        {social.map((s) => (
          <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined} class="card" style="padding:1.5rem;">
            <h3 class="post-title" style="font-size:1.15rem; margin-bottom:0.3rem;">{s.label}</h3>
            <span style="font-family:var(--fm); font-size:0.72rem; color:var(--mid);">{s.handle}</span>
          </a>
        ))}
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">Support the writing</div>
      <p style="color:var(--muted); max-width:36rem; line-height:1.75; margin-bottom:1.25rem;">
        Everything here is free to read. If something helped, you can buy me a pint.
      </p>
      <PintButton />
    </section>
  </main>

  <Footer />
</BaseLayout>
