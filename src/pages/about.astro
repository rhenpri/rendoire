---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const values = [
  { title: 'Build things that work', desc: 'Software that has to survive contact with the real world, not just a demo.' },
  { title: 'Own your tools', desc: 'Data and devices you control, because digital sovereignty is a practice, not a slogan.' },
  { title: 'Learn in public', desc: 'I write to figure things out, and share the useful parts along the way.' },
];

const social = [
  { label: 'Medium', handle: '@rendoire', href: 'https://rendoire.medium.com' },
  { label: 'GitHub', handle: 'rhenpri', href: 'https://github.com/rhenpri' },
  { label: 'LinkedIn', handle: 'rhenderson832', href: 'https://www.linkedin.com/in/rhenderson832/' },
  { label: 'YouTube', handle: '@rendoire', href: 'https://www.youtube.com/@rendoire' },
  { label: 'RSS', handle: 'feed.xml', href: '/feed.xml' },
];

const euResources = [
  { name: 'Free Software Foundation Europe', desc: 'The leading European voice for software freedom and open standards.', href: 'https://fsfe.org', eu: true },
  { name: 'European Commission · Digital Strategy', desc: 'The EU\u2019s policy hub for open source, data, and digital sovereignty.', href: 'https://digital-strategy.ec.europa.eu', eu: true },
  { name: 'EU Open Source Observatory', desc: 'Tracks open source policy and adoption across EU public services.', href: 'https://joinup.ec.europa.eu/collection/open-source-observatory-osor', eu: true },
  { name: 'Next Generation Internet', desc: 'EU-funded programme building an open, human-centric internet.', href: 'https://www.ngi.eu', eu: true },
  { name: 'Linux Foundation Europe', desc: 'The European hub for open source industry and standards.', href: 'https://linuxfoundation.eu', eu: true },
  { name: 'European Digital Rights (EDRi)', desc: 'The network defending digital rights and freedoms across Europe.', href: 'https://edri.org', eu: true },
  { name: 'Gaia-X', desc: 'European initiative for sovereign, federated data infrastructure.', href: 'https://gaia-x.eu', eu: true },
  { name: 'European Data Protection Board', desc: 'Independent GDPR guidance and enforcement across the EU.', href: 'https://www.edpb.europa.eu', eu: true },
  { name: 'Open Source Initiative', desc: 'Stewards the Open Source Definition and the licenses behind it.', href: 'https://opensource.org' },
  { name: 'Creative Commons', desc: 'Open licensing that keeps content and culture shareable.', href: 'https://creativecommons.org' },
];

const domain = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<BaseLayout
  title="About — rendoire"
  description="Software and AI, and keeping my data on machines I own."
  canonical="https://rendoire.com/about/"
>
  <Navigation />

  <main id="main" class="container section" style="padding-top: 4rem;">
    <div class="section-label">About</div>
    <h1 class="section-title">Nice to <em>meet you</em></h1>
    <p class="lead">
      I'm rendoire. I write about artificial intelligence and software, and I keep my data on
      machines I actually own. This site is the overlap of those three things — the writing,
      the recommendations, and the tools.
    </p>

    <section style="margin-top: 4rem;">
      <div class="section-label">What I care about</div>
      <div class="post-grid">
        {values.map((v) => (
          <div class="card" style="min-height: 150px;">
            <h3 class="post-title" style="font-size:1.3rem;">{v.title}</h3>
            <p class="post-desc" style="-webkit-line-clamp: unset;">{v.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">Read more</div>
      <h2 class="section-title" style="font-size:2.2rem;">EU &amp; <em>open source</em></h2>
      <p class="lead" style="margin-top:-1rem; margin-bottom:2rem;">
        Reputable places to go deeper on European technology and open source — the ideas this
        site is built on.
      </p>
      <div class="dir-grid">
        {euResources.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="card dir-card">
            <div class="dir-card-top">
              <h3 class="dir-name" style="font-size:1.2rem;">{r.name}</h3>
              {r.eu && <span class="eu-badge" title="European">EU</span>}
            </div>
            <p class="dir-why">{r.desc}</p>
            <span class="dir-link">{domain(r.href)} ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section style="margin-top: 4rem;">
      <div class="section-label">Find me</div>
      <div class="post-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
        {social.map((s) => (
          <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined} class="card" style="padding:1.5rem;">
            <h3 class="post-title" style="font-size:1.15rem; margin-bottom:0.3rem;">{s.label}</h3>
            <span style="font-family:var(--fm); font-size:0.72rem; color:var(--mid);">{s.handle}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
