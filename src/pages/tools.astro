---
// The tools shortlist was folded into /self-hosting/. This page keeps old links
// working: GitHub Pages cannot send a 301, so it redirects in the browser and
// points search engines at the new home with a canonical link.
import BaseLayout from '../layouts/BaseLayout.astro';

const target = '/self-hosting/#phone';
---

<BaseLayout
  title="Moved — rendoire"
  description="The tools shortlist now lives on the self-hosting page."
  canonical="https://rendoire.com/self-hosting/"
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0; url=${target}`} />
  <main id="main" class="container section page-top">
    <p class="lead">
      The tools shortlist has moved to the <a href={target}>self-hosting page</a>.
    </p>
  </main>
</BaseLayout>
