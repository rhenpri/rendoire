---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'rendoire — AI, software & self-hosting',
  description = 'Writing, AI knowledge, and self-hosting recommendations — building and owning your own tools.',
  canonical,
  image = 'https://rendoire.com/og-image.png',
  type = 'website',
  jsonLd,
} = Astro.props;

const resolvedCanonical =
  canonical ??
  (Astro.url.pathname === '/' ? 'https://rendoire.com/' : `https://rendoire.com${Astro.url.pathname}`);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Security: baseline content-security-policy + referrer policy.
         Full HTTP headers (HSTS, frame-ancestors, etc.) belong at the edge —
         see docs/SECURITY.md for the proxy snippet. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Impact.com site verification (O'Reilly affiliate program) -->
    <meta name="impact-site-verification" value="d36d74d2-200e-4f33-bf6a-7c2579cad7c6" />

    <link rel="canonical" href={resolvedCanonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="rendoire" href="/feed.xml" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="rendoire" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <slot />

    <script is:inline>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('visible')),
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
