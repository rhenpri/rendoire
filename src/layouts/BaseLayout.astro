---
import '../styles/global.css';
import { goatcounterOrigin, site } from '../config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Absolute URL, or a site-relative path such as /og-image.png */
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (404 and the like). */
  noindex?: boolean;
}

const {
  title = 'rendoire — AI, software & self-hosting',
  description = site.description,
  canonical,
  image = '/og-image.png',
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, site.url).href;
const resolvedImage = new URL(image, site.url).href;
// Analytics only add their own origin; scripts stay same-origin files.
const gc = goatcounterOrigin ? ` ${goatcounterOrigin}` : '';
const csp = `default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:${gc}; font-src 'self' data:; connect-src 'self'${gc}; object-src 'none'; base-uri 'self'; form-action 'self'`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Security: baseline content-security-policy + referrer policy.
         Every asset is served from this origin. The one exception is the
         GoatCounter endpoint, which may receive page counts (connect/img).
         Scripts are files only (no inline script can run).
         Full HTTP headers (HSTS, frame-ancestors, etc.) belong at the edge —
         see docs/SECURITY.md for the proxy snippet. -->
    <meta
      http-equiv="Content-Security-Policy"
      content={csp}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Impact.com site verification (O'Reilly affiliate program) -->
    <meta name="impact-site-verification" value="d36d74d2-200e-4f33-bf6a-7c2579cad7c6" />

    <link rel="canonical" href={resolvedCanonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="rendoire" href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="rendoire" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Scroll-reveal content starts hidden; without scripts, show it. -->
    <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>

    {goatcounterOrigin && !noindex && (
      <script is:inline async src="/js/count.js" data-goatcounter={`${goatcounterOrigin}/count`}></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <slot />

    <script>
      // Scroll reveal
      (function () {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }),
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
