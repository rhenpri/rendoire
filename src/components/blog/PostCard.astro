---
import type { PostSummary } from '../../lib/blog';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}/`} class="post-card card-polished" data-tags={post.tags.join(',')}>
  {post.cover && (
    <div class="post-card-media">
      <img src={post.cover} alt="" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="post-meta">
    <span>{post.dateLabel}</span>
    <span>{post.readingTime}</span>
  </div>

  <h3 class="post-title">{post.title}</h3>
  {post.description && <p class="post-desc">{post.description}</p>}

  {post.tags.length > 0 && (
    <div class="post-tags">
      {post.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
    </div>
  )}

  <span class="post-arrow">Read →</span>
</a>
