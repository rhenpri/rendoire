    <div class="footer-grid">
      <div>
        <div class="footer-brand">ren<em>doire</em></div>
        <p class="footer-desc">
          Essays on artificial intelligence, software engineering, and the quieter art of
          building systems you actually own.
        </p>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/blog">Writing</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/lab">Lab</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Elsewhere</h4>
        <ul>
          <li><a href="https://rendoire.medium.com" target="_blank" rel="noopener">Medium</a></li>
          <li><a href="https://github.com/rhenpri" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/rhenderson832/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} rendoire. Content licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener" style="text-decoration:underline">CC-BY 4.0</a>.</span>
      <span>build:{buildHash} · <a href="/.well-known/security.txt" style="text-decoration:underline">security.txt</a></span>
