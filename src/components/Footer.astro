---
import { execSync } from 'child_process';
import PintButton from './PintButton.astro';
import { author } from '../config';

let buildHash = 'dev';
try {
  buildHash = execSync('git rev-parse --short HEAD').toString().trim();
} catch {}

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">ren<em>doire</em></div>
        <p class="footer-desc">
          Essays by {author.name} on putting AI to work in the real world, plus the tools I
          recommend for owning your own data and devices.
        </p>
        <p class="footer-flag">
          Developed in 🇮🇪 Ireland · Championing 🇪🇺 European technology &amp; open source
        </p>
        <PintButton compact />
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/blog/">Writing</a></li>
          <li><a href="/self-hosting/">Self-hosting</a></li>
          <li><a href="/ai/">AI resources</a></li>
          <li><a href="/savings/">Savings calculator</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Elsewhere</h4>
        <ul>
          <li><a href="https://rendoire.medium.com" target="_blank" rel="noopener">Medium</a></li>
          <li><a href="https://github.com/rhenpri" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/rhenderson832/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {author.name}. Content licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener" style="text-decoration:underline">CC-BY 4.0</a>.</span>
      <span>build:{buildHash} · <a href="/.well-known/security.txt" style="text-decoration:underline">security.txt</a></span>
    </div>
  </div>
</footer>
