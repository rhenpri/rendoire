---
// Hero diagram: services leaving the cloud for one box you own.
// Decorative, so hidden from assistive tech; the tagline says the same thing.

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const services = ['Photos', 'Films', 'Music', 'Notes', 'AI'];

// Layout in viewBox units (520 × 340).
const chip = { x: 16, w: 112, h: 34, gap: 22 };
const top = 42;
const box = { x: 372, y: 96, w: 132, h: 160 };
const bayH = box.h / services.length;

const rows = services.map((label, i) => {
  const cy = top + i * (chip.h + chip.gap) + chip.h / 2;
  const by = box.y + i * bayH + bayH / 2;
  const x0 = chip.x + chip.w;
  const x1 = box.x;
  const mid = (x0 + x1) / 2;
  return {
    label,
    y: cy - chip.h / 2,
    cy,
    by,
    path: `M${x0},${cy} C${mid},${cy} ${mid},${by} ${x1},${by}`,
    delay: i * 0.55,
  };
});
---

<svg viewBox="0 0 520 340" class:list={['ov', className]} fill="none" aria-hidden="true">
  <text x={chip.x} y="22" class="ov-cap">rented</text>
  <text x={box.x} y={box.y - 18} class="ov-cap">owned</text>

  {rows.map((r) => (
    <g>
      <path d={r.path} class="ov-wire" />
      <path d={r.path} class="ov-flow" style={`animation-delay:${-r.delay}s`} />
      <rect x={chip.x} y={r.y} width={chip.w} height={chip.h} rx="5" class="ov-chip" />
      <text x={chip.x + 14} y={r.cy + 4} class="ov-label">{r.label}</text>
      <circle r="4" class="ov-dot" style={`offset-path:path('${r.path}');animation-delay:${r.delay}s`} />
    </g>
  ))}

  <rect x={box.x} y={box.y} width={box.w} height={box.h} rx="8" class="ov-box" />
  {rows.map((r, i) => (
    <g>
      {i > 0 && <path d={`M${box.x},${box.y + i * bayH} h${box.w}`} class="ov-bay" />}
      <circle cx={box.x + 18} cy={r.by} r="3.5" class="ov-led" style={`animation-delay:${r.delay}s`} />
      <path d={`M${box.x + 34},${r.by} h${box.w - 52}`} class="ov-slot" />
    </g>
  ))}
</svg>

<style>
  .ov {
    display: block;
    width: 100%;
    height: auto;
    --ov-cycle: 4.4s;
  }
  .ov-cap,
  .ov-label {
    font-family: var(--fm);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ov-cap {
    fill: var(--mid);
  }
  .ov-label {
    fill: var(--muted);
  }
  .ov-chip {
    stroke: var(--border-strong);
    stroke-dasharray: 3 4;
  }
  .ov-wire {
    stroke: var(--border);
    stroke-width: 1;
  }
  .ov-flow {
    stroke: var(--purple);
    stroke-width: 1;
    stroke-dasharray: 2 10;
    opacity: 0.55;
    animation: ov-flow 1.8s linear infinite;
  }
  .ov-box {
    stroke: var(--green);
    stroke-width: 1.5;
    fill: var(--green-dim);
  }
  .ov-bay {
    stroke: rgba(62, 207, 142, 0.25);
  }
  .ov-slot {
    stroke: rgba(62, 207, 142, 0.3);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .ov-led {
    fill: var(--green);
    opacity: 0.25;
    animation: ov-led var(--ov-cycle) linear infinite;
  }
  .ov-dot {
    fill: var(--purple);
    offset-rotate: 0deg;
    offset-distance: 0%;
    opacity: 0;
    animation: ov-move var(--ov-cycle) cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  /* A packet leaves its chip, crosses, and turns green as it lands. */
  @keyframes ov-move {
    0% {
      offset-distance: 0%;
      opacity: 0;
      fill: var(--purple);
    }
    8% {
      opacity: 1;
    }
    40% {
      fill: var(--purple);
    }
    58% {
      offset-distance: 100%;
      opacity: 1;
      fill: var(--green);
    }
    66%,
    100% {
      offset-distance: 100%;
      opacity: 0;
      fill: var(--green);
    }
  }
  /* The bay's light comes on as its packet arrives, then fades. */
  @keyframes ov-led {
    0%,
    52% {
      opacity: 0.25;
    }
    60% {
      opacity: 1;
    }
    100% {
      opacity: 0.25;
    }
  }
  @keyframes ov-flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  /* Still version: every service already landed. */
  @media (prefers-reduced-motion: reduce) {
    .ov-flow,
    .ov-led,
    .ov-dot {
      animation: none;
    }
    .ov-dot {
      display: none;
    }
    .ov-led {
      opacity: 1;
    }
  }
</style>
